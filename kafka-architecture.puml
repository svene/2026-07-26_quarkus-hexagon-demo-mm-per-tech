@startuml kafka-architecture
left to right direction
skinparam packageStyle rectangle
skinparam defaultTextAlignment center
skinparam componentStyle rectangle
skinparam ArrowColor #555555

' =============================================================================
' FAR LEFT: Kafka topics (external event sources)
' =============================================================================

queue "cashpoint-purchases" as T_CASHPOINT
queue "fruit-deliveries" as T_FRUIT
queue "vegetables-deliveries" as T_VEG
queue "dairy-deliveries" as T_DAIRY
queue "beverages-deliveries" as T_BEV
queue "meat-deliveries" as T_MEAT
queue "bakery-deliveries" as T_BAKERY
queue "nonfood-deliveries" as T_NONFOOD_DEL

' =============================================================================
' LEFT: External drivers + Inbound adapters
' =============================================================================

actor "Browser\n(HTTP orders)" as Browser

package "external-inbound-kafka" {
  component "CashpointStub\n@Scheduled every=10s" as CashpointStub
}

package "inbound-http.jsonapi\n[JAX-RS — JSON API]" as INBOUND_REST {
  component "AdminReceiver\nPOST /admin/order-nonfood" as AdminReceiver
}

package "inbound-kafka\n[SmallRye @Incoming]" as INBOUND_KAFKA {
  component "FruitDeliveryReceiver" as FruitRcv
  component "VegetablesDeliveryReceiver" as VegRcv
  component "DairyDeliveryReceiver" as DairyRcv
  component "BeveragesDeliveryReceiver" as BevRcv
  component "MeatDeliveryReceiver" as MeatRcv
  component "BakeryDeliveryReceiver" as BakeryRcv
  component "NonFoodDeliveryReceiver" as NonFoodRcv
  component "CashpointReceiver" as CashpointRcv
}

' =============================================================================
' CENTER: Core handlers
' =============================================================================

package "core\n[use cases]" as CORE {
  component "InventoryHandler\n→ addAmount()\n→ log()" as InventoryHandler
  component "PurchaseHandler\n→ deductAmount()\n→ log()" as PurchaseHandler
  component "NonFoodHandler\norder()" as NonFoodHandler
}

' =============================================================================
' RIGHT: Outbound adapter
' =============================================================================

package "outbound-kafka\n[SmallRye @Channel Emitter]" as OUTBOUND_KAFKA {
  component "NonFoodSupplierService\nchannels: nonfood-orders-out" as NonFoodSvc
}

' =============================================================================
' FAR RIGHT: External stubs + Kafka topics (outputs)
' =============================================================================

queue "nonfood-orders" as T_NONFOOD_ORDERS

package "external-outbound-rest\n[JAX-RS + Kafka producer]" as EXT_REST {
  component "FruitSupplierStub" as FruitStub
  component "VegetablesSupplierStub" as VegStub
  component "DairySupplierStub" as DairyStub
}

package "external-outbound-soap\n[CXF SOAP + Kafka producer]" as EXT_SOAP {
  component "BeverageSupplierStub" as BevStub
  component "MeatSupplierStub" as MeatStub
  component "BakerySupplierStub" as BakeryStub
}

package "external-outbound-kafka\n[Kafka consumer/producer]" as EXT_KAFKA {
  component "NonFoodSupplierStub" as NonFoodStub
}

' =============================================================================
' CONNECTIONS: Event flow left-to-right through core
' =============================================================================

' Input topics → inbound receivers
T_CASHPOINT --> CashpointRcv : consume
T_FRUIT --> FruitRcv : consume
T_VEG --> VegRcv : consume
T_DAIRY --> DairyRcv : consume
T_BEV --> BevRcv : consume
T_MEAT --> MeatRcv : consume
T_BAKERY --> BakeryRcv : consume
T_NONFOOD_DEL --> NonFoodRcv : consume

' External driver produces
CashpointStub --> T_CASHPOINT : produce

' Inbound receivers → core handlers
FruitRcv --> InventoryHandler : invoke
VegRcv --> InventoryHandler : invoke
DairyRcv --> InventoryHandler : invoke
BevRcv --> InventoryHandler : invoke
MeatRcv --> InventoryHandler : invoke
BakeryRcv --> InventoryHandler : invoke
NonFoodRcv --> InventoryHandler : invoke
CashpointRcv --> PurchaseHandler : invoke

' HTTP order → core
Browser --> AdminReceiver : HTTP
AdminReceiver --> NonFoodHandler : invoke order()

' Core → outbound
NonFoodHandler --> NonFoodSvc : call

' Outbound → external
NonFoodSvc --> T_NONFOOD_ORDERS : produce

' External stubs consume orders and produce deliveries
T_NONFOOD_ORDERS --> NonFoodStub : consume
NonFoodStub --> T_NONFOOD_DEL : produce

' REST/SOAP stubs produce delivery events
FruitStub --> T_FRUIT : produce
VegStub --> T_VEG : produce
DairyStub --> T_DAIRY : produce
BevStub --> T_BEV : produce
MeatStub --> T_MEAT : produce
BakeryStub --> T_BAKERY : produce

@enduml
