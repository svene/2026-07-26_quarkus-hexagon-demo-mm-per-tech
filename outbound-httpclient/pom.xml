  <artifactId>outbound-httpclient</artifactId>
  <packaging>jar</packaging>

  <name>outbound-httpclient</name>
  <description>Outbound adapter: implements a port from core representing a call
    to a remote HTTP/REST service (distinct from outbound-webservice,
    e.g. a different remote system with its own client/DTOs).</description>

  <dependencies>
    <dependency>
      <groupId>org.svenehrke.demo</groupId>
      <artifactId>core</artifactId>
    </dependency>

    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-rest-client</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-rest-client-jackson</artifactId>
    </dependency>
  </dependencies>
</project>
