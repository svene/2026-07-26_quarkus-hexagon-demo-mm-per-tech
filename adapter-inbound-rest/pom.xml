<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.svenehrke.demo</groupId>
    <artifactId>quarkus-hexagon-demo-mm-per-tech</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>adapter-inbound-rest</artifactId>
  <packaging>jar</packaging>

  <name>adapter-inbound-rest</name>
  <description>Inbound adapter: JAX-RS resources that translate HTTP requests into calls
    against core use cases (inbound ports).</description>

  <dependencies>
    <dependency>
      <groupId>org.svenehrke.demo</groupId>
      <artifactId>core</artifactId>
    </dependency>

    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-rest</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-rest-jackson</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-rest-qute</artifactId>
    </dependency>

    <!-- E2E test: all outbound adapters so Dev Services (Postgres, MongoDB, Kafka)
         and WireMock start automatically, mirroring the app-server assembly. -->
    <dependency>
      <groupId>org.svenehrke.demo</groupId>
      <artifactId>adapter-outbound-postgres</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.svenehrke.demo</groupId>
      <artifactId>adapter-outbound-mongodb</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.svenehrke.demo</groupId>
      <artifactId>adapter-outbound-kafka-producer</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.svenehrke.demo</groupId>
      <artifactId>adapter-outbound-webservice</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.svenehrke.demo</groupId>
      <artifactId>adapter-outbound-httpclient</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- quarkus-wiremock is 'provided' in adapter-outbound-webservice so Maven
         does not propagate it; add it directly so the Dev Service starts. -->
    <dependency>
      <groupId>io.quarkiverse.wiremock</groupId>
      <artifactId>quarkus-wiremock</artifactId>
      <version>1.6.3</version>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>io.rest-assured</groupId>
      <artifactId>rest-assured</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
