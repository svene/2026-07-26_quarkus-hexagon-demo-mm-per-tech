<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>org.svenehrke.demo</groupId>
  <artifactId>quarkus-hexagon-demo-mm-per-tech</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>quarkus-hexagon-demo-mm-per-tech</name>
  <description>Demo system illustrating hexagonal architecture with Quarkus, one Maven module per adapter technology</description>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <!-- Check https://quarkus.io for the latest stable/LTS version before you start -->
    <quarkus.platform.group-id>io.quarkus.platform</quarkus.platform.group-id>
    <quarkus.platform.artifact-id>quarkus-bom</quarkus.platform.artifact-id>
    <quarkus.platform.version>3.33.2.1</quarkus.platform.version>

    <assertj.version>3.26.3</assertj.version>
  </properties>

  <modules>
    <module>core</module>
    <module>inbound-rest</module>
    <module>inbound-kafka</module>
    <module>outbound-postgres</module>
    <module>outbound-mongodb</module>
    <module>outbound-webservice</module>
    <module>outbound-httpclient</module>
    <module>external-outbound-rest</module>
    <module>external-outbound-soap</module>
    <module>external-outbound-kafka</module>
    <module>external-inbound-kafka</module>
    <module>outbound-kafka</module>
    <module>app-server</module>
  </modules>

  <dependencyManagement>
    <dependencies>
      <!-- Quarkus BOM: aligns all Quarkus extension versions across every module -->
      <dependency>
        <groupId>${quarkus.platform.group-id}</groupId>
        <artifactId>${quarkus.platform.artifact-id}</artifactId>
        <version>${quarkus.platform.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <dependency>
        <groupId>org.assertj</groupId>
        <artifactId>assertj-core</artifactId>
        <version>${assertj.version}</version>
        <scope>test</scope>
      </dependency>

      <!-- Inter-module dependencies: every adapter and app-server can depend on core -->
      <dependency>
        <groupId>org.svenehrke.demo</groupId>
        <artifactId>core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.svenehrke.demo</groupId>
        <artifactId>inbound-rest</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.svenehrke.demo</groupId>
        <artifactId>inbound-kafka</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.svenehrke.demo</groupId>
        <artifactId>outbound-postgres</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.svenehrke.demo</groupId>
        <artifactId>outbound-mongodb</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.svenehrke.demo</groupId>
        <artifactId>outbound-webservice</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.svenehrke.demo</groupId>
        <artifactId>outbound-httpclient</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.svenehrke.demo</groupId>
        <artifactId>external-outbound-rest</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.svenehrke.demo</groupId>
        <artifactId>external-outbound-soap</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.svenehrke.demo</groupId>
        <artifactId>external-outbound-kafka</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.svenehrke.demo</groupId>
        <artifactId>external-inbound-kafka</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.svenehrke.demo</groupId>
        <artifactId>outbound-kafka</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- Every module gets JUnit 5 for tests -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-junit5</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>${quarkus.platform.group-id}</groupId>
          <artifactId>quarkus-maven-plugin</artifactId>
          <version>${quarkus.platform.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <configuration>
            <release>${maven.compiler.release}</release>
            <parameters>true</parameters>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <configuration>
            <systemPropertyVariables>
              <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
            </systemPropertyVariables>
          </configuration>
        </plugin>
        <plugin>
          <groupId>io.smallrye</groupId>
          <artifactId>jandex-maven-plugin</artifactId>
          <version>3.2.4</version>
        </plugin>
      </plugins>
    </pluginManagement>

    <!-- Generate META-INF/jandex.idx in every module so Quarkus can discover
         CDI beans in dependency JARs without quarkus.index-dependency config. -->
    <plugins>
      <plugin>
        <groupId>io.smallrye</groupId>
        <artifactId>jandex-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>make-index</id>
            <goals>
              <goal>jandex</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
