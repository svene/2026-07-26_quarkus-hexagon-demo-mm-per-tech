  <artifactId>outbound-kafka-producer</artifactId>
  <packaging>jar</packaging>

  <name>adapter-outbound-kafka-producer</name>
  <description>Outbound adapter: implements an event-publishing port from core
    by emitting (@Outgoing) records to a Kafka topic.
    In dev/test mode, Quarkus Dev Services starts a real Kafka-compatible broker
    (Redpanda by default) automatically - no manual setup required.</description>

  <dependencies>
    <dependency>
      <groupId>org.svenehrke.demo</groupId>
      <artifactId>core</artifactId>
    </dependency>

    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-messaging-kafka</artifactId>
    </dependency>

    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-jackson</artifactId>
    </dependency>
  </dependencies>
</project>
