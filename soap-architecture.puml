@startuml soap-architecture
left to right direction
skinparam packageStyle rectangle
skinparam defaultTextAlignment center
skinparam componentStyle rectangle
skinparam ArrowColor #555555

' =============================================================================
' LEFT: External driver + Inbound adapter
' =============================================================================

actor "Browser\n(Admin orders)" as Browser

package "inbound-http.html\n[JAX-RS — HTML UI]" as INBOUND_REST {
  component "AdminReceiver\nPOST /admin/order-beverages\nPOST /admin/order-meat\nPOST /admin/order-bakery" as AdminReceiver
}

' =============================================================================
' CENTER: Core SOAP handlers
' =============================================================================

package "core\n[use cases]" as CORE {
  component "BeveragesHandler\norder()" as BeveragesHandler
  component "MeatHandler\norder()" as MeatHandler
  component "BakeryHandler\norder()" as BakeryHandler
}

' =============================================================================
' RIGHT: Outbound SOAP adapters
' =============================================================================

package "outbound-webservice\n[Apache CXF — SOAP client]" as OUTBOUND_SOAP {
  component "BeverageSupplierService\n/soap/beverage-supplier" as BevSvc
  component "MeatSupplierService\n/soap/meat-supplier" as MeatSvc
  component "BakerySupplierService\n/soap/bakery-supplier" as BakerySvc
}

' =============================================================================
' FAR RIGHT: External SOAP stubs
' =============================================================================

package "external-outbound-soap\n[CXF SOAP server + Kafka producer]" as EXT_SOAP {
  component "BeverageSupplierStub\n/soap/beverage-supplier" as BevStub
  component "MeatSupplierStub\n/soap/meat-supplier" as MeatStub
  component "BakerySupplierStub\n/soap/bakery-supplier" as BakeryStub
}

' =============================================================================
' CONNECTIONS: SOAP request/response flow left-to-right through core
' =============================================================================

' Left: Browser → inbound adapter
Browser --> AdminReceiver : HTTP form orders

' Left to center: Inbound → core handlers
AdminReceiver --> BeveragesHandler : call order()
AdminReceiver --> MeatHandler : call order()
AdminReceiver --> BakeryHandler : call order()

' Center to right: Core handlers → outbound SOAP adapters
BeveragesHandler --> BevSvc : SOAP placeOrder()
MeatHandler --> MeatSvc : SOAP placeOrder()
BakeryHandler --> BakerySvc : SOAP placeOrder()

' Right to far right: Outbound → external SOAP stubs
BevSvc --> BevStub : SOAP request
MeatSvc --> MeatStub : SOAP request
BakerySvc --> BakeryStub : SOAP request

' Far right to right: Stubs respond
BevStub --> BevSvc : SOAP response
MeatStub --> MeatSvc : SOAP response
BakeryStub --> BakerySvc : SOAP response

' Response chain back to browser
BevSvc --> BeveragesHandler : return
MeatSvc --> MeatHandler : return
BakerySvc --> BakeryHandler : return

BeveragesHandler --> AdminReceiver : return
MeatHandler --> AdminReceiver : return
BakeryHandler --> AdminReceiver : return

' Left to external: Response to driver
AdminReceiver --> Browser : HTTP response

note right of BevStub
  After responding, stubs emit
  Kafka delivery events asynchronously
end note

@enduml
