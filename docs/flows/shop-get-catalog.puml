@startuml shop_get_catalog
!theme plain
skinparam sequenceMessageAlign center
skinparam backgroundColor #ffffff

actor "Customer" as user
participant "ShopReceiver\n(HTTP)" as receiver
participant "ProductsHandler\n(Core)" as handler
participant "InventoryService\n(PostgreSQL)" as inventory
database "PostgreSQL\n(Products)" as db

user -> receiver: GET /shop
receiver -> handler: listAll()
handler -> inventory: findAll()
inventory -> db: SELECT * FROM products
db --> inventory: Product[]
inventory --> handler: Product[]
receiver -> receiver: filter in-stock\n(availableAmount > 0)
receiver --> user: HTML (Shop Catalog with In-Stock Products)

@enduml
