@startuml admin_order_fruits
!theme plain
skinparam sequenceMessageAlign center
skinparam backgroundColor #ffffff

actor "Admin" as user
participant "AdminReceiver\n(HTTP)" as receiver
participant "FruitsHandler\n(Core)" as handler
participant "AuditLogService\n(MongoDB)" as audit
participant "FruitSupplierService\n(REST)" as service
participant "FruitSupplierStub\n(External)" as stub
participant "Kafka Topic:\nfruit-deliveries" as kafka_out
participant "FruitDeliveryReceiver\n(Kafka)" as kafka_receiver
participant "InventoryHandler\n(Core)" as inv_handler
participant "InventoryService\n(PostgreSQL)" as inventory
database "PostgreSQL\n(Inventory)" as db_inv
database "MongoDB\n(Audit)" as db_audit

user -> receiver: POST /admin/order-fruits\n(productName, quantity)
receiver -> handler: order(productName, quantity)
handler -> audit: log("FRUITS_ORDER_RECEIVED")
audit -> db_audit: Insert audit entry
audit --> handler
handler -> service: placeOrder(productName, quantity)
service -> stub: REST call (in-process)
stub -> kafka_out: publish delivery message
kafka_out --> service: ack
service --> handler
handler -> audit: log("FRUITS_ORDER_PLACED")
audit -> db_audit: Insert audit entry
audit --> handler
handler --> receiver
receiver --> user: OK (204 No Content)

note right of kafka_out
  Asynchronous path begins
end note

kafka_out -> kafka_receiver: consume delivery message
kafka_receiver -> inv_handler: updateFruitAmount(productName, quantity)
inv_handler -> audit: log("FRUIT_DELIVERY_RECEIVED")
audit -> db_audit: Insert audit entry
audit --> inv_handler
inv_handler -> inventory: addAmount(productName, quantity)
inventory -> db_inv: UPDATE products SET availableAmount += quantity
db_inv --> inventory
inventory --> inv_handler
inv_handler -> audit: log("FRUIT_INVENTORY_UPDATED")
audit -> db_audit: Insert audit entry
audit --> inv_handler

@enduml
