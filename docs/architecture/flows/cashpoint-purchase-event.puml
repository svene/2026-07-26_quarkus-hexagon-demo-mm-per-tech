@startuml cashpoint_purchase_event
skinparam monochrome true
skinparam sequenceMessageAlign center
skinparam backgroundColor #ffffff

actor "External\nCheckout System" as external
participant "Kafka Topic:\ncashpoint-purchases" as kafka
participant "CashpointReceiver\n(Kafka)" as receiver
participant "PurchaseHandler\n(Core)" as handler
participant "AuditLogService\n(MongoDB)" as audit
participant "InventoryService\n(PostgreSQL)" as inventory
database "PostgreSQL\n(Inventory)" as db_inv
database "MongoDB\n(Audit)" as db_audit

external -> kafka: publish purchase message\n{items: [{product, qty}, ...]}

kafka -> receiver: consume (@Incoming)
receiver -> audit: log("PURCHASE_RECEIVED")
audit -> db_audit: Insert audit entry
audit --> receiver
receiver -> handler: recordStoreSale(purchase)
handler -> audit: log("PURCHASE_PROCESSING")
audit -> db_audit: Insert audit entry
audit --> handler

note right of handler
  Physical store: the goods are already gone,
  so the sale is recorded, never rejected.
end note
handler -> inventory: deductAll(quantities by product name, CAP_AT_ZERO)
note right of inventory
  One transaction; rows locked
  (SELECT ... FOR UPDATE) in product-name order.
end note
loop for each product (sorted by name)
  inventory -> db_inv: SELECT ... FOR UPDATE
  db_inv --> inventory: ProductEntity
  inventory -> inventory: availableAmount = max(0, availableAmount - quantity)\nless than sold (or unknown product)? record Shortage
end
inventory -> db_inv: COMMIT
inventory --> handler: StockDeduction(updated, shortages)

opt any product updated
  handler -> audit: log("INVENTORY_DEDUCTED", summary)
  audit -> db_audit: Insert audit entry
  audit --> handler
end
loop for each shortage (inventory was wrong)
  handler -> audit: log("STOCK_DISCREPANCY", "sold N, only M on record")
  audit -> db_audit: Insert audit entry
  audit --> handler
end

note right of receiver
  Event processed asynchronously
  Response not sent to external system
end note

@enduml
