@startuml auto_tills
skinparam monochrome true
skinparam sequenceMessageAlign center
skinparam backgroundColor #ffffff

participant "AutoTillsReceiver\n(inbound-event, @ObservesAsync)" as receiver
participant "AutoTillsHandler\n(Core)" as handler
participant "OccupancyService\n(PostgreSQL)" as repo
participant "CheckoutSystemService\n(REST client)" as service
participant "CashpointTillsStub\n(External)" as stub
participant "CashpointStub\n(External)" as sim
participant "Kafka Topic:\nstore-occupancy" as kafka
participant "AuditLogService\n(MongoDB)" as audit

note over receiver
  OccupancyChanged(store): a newer report was stored
  (see store-occupancy.puml). Off with
  inventory.auto-tills.enabled=false (tests, e2e).
end note
receiver -> handler: adjust(store)
handler -> repo: findAll() → the store's latest report
alt measured < 10 s after the store's last change (cooldown)
  handler --> receiver: no decision
else
  handler -> handler: TillPolicy.decide(occupancy)\n+1: queuing > tills, or full and every till busy\n−1: nobody queuing and ≥ 2 tills free\n(within 1..8; else no change)
  opt a change
    handler -> service: setTills(tillCount)
    service -> stub: PUT /cashpoint-stub/stores/{id}/tills {"tills": n}
    stub -> sim: requestTills(storeId, n) (queued)
    stub --> service: 204
    handler -> audit: log("TILLS_OPENED" / "TILLS_CLOSED")\n(or "TILLS_CHANGE_FAILED": no cooldown, judged again)
    note over sim
      Next tick (100 ms): StoreSimulation.setTills(n) -
      a busy till closes once its customer has paid.
    end note
    sim -> kafka: report occupancy right away\n(→ OccupancyChanged again, inside the cooldown)
  end
end

@enduml
