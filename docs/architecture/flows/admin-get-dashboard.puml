@startuml admin_get_dashboard
skinparam monochrome true
skinparam sequenceMessageAlign center
skinparam backgroundColor #ffffff

actor "Browser" as user
participant "AdminReceiver\n(HTTP)" as receiver
participant "ProductsHandler\n(Core)" as handler
participant "InventoryService\n(PostgreSQL)" as inventory
database "PostgreSQL\n(Products)" as db

user -> receiver: GET /admin
receiver --> user: static page shell
user -> receiver: GET /admin/page (hx-trigger=load)
receiver -> handler: listAll()
handler -> inventory: findAll()
inventory -> db: SELECT * FROM products
db --> inventory: Product[]
inventory --> handler: Product[]
handler --> receiver: Product[]
receiver --> user: JSON {route: AdminPage, vm}
user -> user: render with hono/html\n(hx-hono.js)

@enduml
