@startuml inventory_events
skinparam monochrome true
skinparam sequenceMessageAlign center
skinparam backgroundColor #ffffff

actor "Customer / Admin" as user
participant "InventoryEventsReceiver\n(HTTP)" as receiver
participant "ShopReceiver /\nAdminReceiver\n(HTTP)" as page
participant "InventoryChangesHandler\n(Core)" as changes
participant "InventoryHandler /\nPurchaseHandler\n(Core)" as handler
participant "ProductsHandler\n(Core)" as products
database "PostgreSQL\n(Products)" as db

user -> receiver: GET /inventory/events (hx-sse:connect)
receiver -> changes: subscribe changes()
receiver --> user: event: inventoryChanged (on connect)

== an inventory change (Kafka delivery, checkout, cashpoint sale) ==
handler -> db: addAmount / deductAll (committed)
handler -> changes: publishChange()
changes -> receiver: InventoryChanged
receiver --> user: event: inventoryChanged

user -> page: GET /shop/inventory-fragment or /admin/inventory-fragment\n(hx-trigger="inventoryChanged from:body")
page -> products: listAll()
products -> db: SELECT * FROM products
page --> user: JSON {route: ShopProducts | AdminInventory, vm}
user -> user: render + innerMorph into #shop-products / #admin-inventory\n(typed quantities survive)

@enduml
