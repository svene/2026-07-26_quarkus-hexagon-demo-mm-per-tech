@startuml admin_order_beverages
skinparam monochrome true
skinparam sequenceMessageAlign center
skinparam backgroundColor #ffffff

actor "Admin" as user
participant "AdminReceiver\n(HTTP)" as receiver
participant "BeveragesHandler\n(Core)" as handler
participant "AuditLogService\n(MongoDB)" as audit
participant "BeverageSupplierService\n(SOAP)" as service
participant "BeverageSupplierStub\n(SOAP, External)" as stub
participant "Kafka Topic:\nbeverages-deliveries" as kafka_out
participant "BeveragesDeliveryReceiver\n(Kafka)" as kafka_receiver
participant "InventoryHandler\n(Core)" as inv_handler
participant "SupplierOrderService\n(PostgreSQL)" as inventory
database "PostgreSQL\n(Inventory)" as db_inv
database "MongoDB\n(Audit)" as db_audit

user -> receiver: POST /admin/order-beverages\n(productName, quantity)
receiver -> audit: log("BEVERAGES_ORDER_RECEIVED")
audit -> db_audit: Insert audit entry
audit --> receiver
receiver -> handler: order(productName, quantity)
handler -> audit: log("BEVERAGES_ORDER_PROCESSING")
audit -> db_audit: Insert audit entry
audit --> handler
handler -> inventory: SupplierOrderRepositorySPI.open(…, MANUAL)\n(recorded before sending: the delivery may arrive first)
inventory -> db_inv: INSERT supplier_order (OPEN)
handler -> service: placeOrder(productName, quantity)\n(throws → cancel the order)
service -> stub: SOAP call (in-process)
stub -> kafka_out: publish delivery message
kafka_out --> service: ack
service --> handler
handler -> audit: log("BEVERAGES_ORDER_PLACED")
audit -> db_audit: Insert audit entry
audit --> handler
handler --> receiver
receiver --> user: OK (204 No Content)

note right of kafka_out
  Asynchronous delivery path begins
end note

kafka_out -> kafka_receiver: consume delivery message
kafka_receiver -> audit: log("BEVERAGE_DELIVERY_RECEIVED")
audit -> db_audit: Insert audit entry
audit --> kafka_receiver
kafka_receiver -> inv_handler: updateBeverageAmount(productName, quantity)
inv_handler -> inventory: receiveDelivery(productName, type, quantity)
inventory -> db_inv: one transaction: UPDATE stock (DC row) += quantity;\nclose open supplier_orders of the product oldest first
db_inv --> inventory
inventory --> inv_handler
inv_handler -> audit: log("BEVERAGE_INVENTORY_UPDATED")
audit -> db_audit: Insert audit entry
audit --> inv_handler
note right of inv_handler
  then fires DeliveredToDc asynchronously (after the commit):
  inbound-event's DeliveryEventReceiver calls
  ReplenishmentHandler.fulfilPending(productName), which serves
  the pending requests of the stores / online FC, shared
  in proportion to what each still needs,
  from the DC stock (see location-request.puml)
end note

@enduml
