  <artifactId>adapter-outbound-mongodb</artifactId>
  <packaging>jar</packaging>

  <name>adapter-outbound-mongodb</name>
  <description>Outbound adapter: implements a persistence port from core using
    MongoDB with Panache.
    In dev/test mode, Quarkus Dev Services starts a real MongoDB container
    automatically - no manual setup or connection string required.</description>

  <dependencies>
    <dependency>
      <groupId>org.svenehrke.demo</groupId>
      <artifactId>core</artifactId>
    </dependency>

    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-mongodb-panache</artifactId>
    </dependency>
  </dependencies>
</project>
